    "popularity": 5,
    "mainIngredients": [
      "鸡胸肉",
      "花生米",
      "干辣椒",
      "花椒",
      "大葱"
    ],
    "tags": [
      "下饭",
      "下酒",
      "宴客"
    ],
    "steps": [
      "鸡胸肉切 1.5 厘米的丁，加生抽、料酒、淀粉抓匀，腌 10 分钟。",
      "调碗汁：糖一勺、醋一勺半、生抽一勺、淀粉半勺、清水两勺，搅匀备用。",
      "冷油下花生米，小火炒到微黄酥脆，盛出摊开晾凉。",
      "油烧热下鸡丁，摊平不动 20 秒再翻，变白就盛出。",
      "底油小火煸干辣椒段和花椒，出香就停别炒黑；下葱段和鸡丁，淋碗汁大火收。",
      "关火后倒入花生米，翻匀出锅。"
    ],
    "tips": "花生米最后放，早一步就软了，这道菜的口感全靠它。",
    "imageQuery": "宫保鸡丁",
    "image": ""
  },
